HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/jingguan_star.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SERVE_FRONTEND=true
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_MODEL_MAX_RETRIES=2
# Agent 状态持久化：sqlite（默认，落盘可恢复/回放）| memory（进程内）
AGENT_CHECKPOINTER=sqlite
AGENT_CHECKPOINT_PATH=data/agent_checkpoints.db
# Skill 匹配方式：auto（LLM 语义选择 + 向量兜底）| llm | vector | keyword
AGENT_SKILL_MATCH=auto
AGENT_SKILL_VECTOR_THRESHOLD=0.25
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
